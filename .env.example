# Local Ollama
JOBPILOT_OLLAMA_URL=http://127.0.0.1:11434
JOBPILOT_OLLAMA_MODEL=

# Optional public employer board tokens/sites (comma separated).
# These are employer-specific feeds, not universal job search indexes.
JOBPILOT_GREENHOUSE_BOARDS=
JOBPILOT_LEVER_SITES=

# Optional Adzuna credentials from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Public deployment (never commit real secrets)
APP_ENV=development
AUTH_ENABLED=false
DATABASE_URL=
JOBPILOT_SECRET_KEY=
CORS_ORIGINS=
STORAGE_ROOT=
UPLOAD_DIR=
GENERATED_DIR=

# Browser automation. Submission remains off until both user and operator opt in.
ALLOW_REAL_SUBMISSIONS=false
AUTOMATION_ALLOWED_HOSTS=
CAPTURE_AUTOMATION_SCREENSHOTS=false
AUTOMATION_DEFAULT_TIMEZONE=Asia/Kolkata
